PORT=3001
NODE_ENV=development

# ── Anthropic Claude API ─────────────────────────────────
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── JWT (session tokens we mint after Firebase verifies phone) ──
# Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# ── Supabase (use SERVICE_KEY now, not anon — RLS is on) ─────
# Project Settings → API → service_role (secret) key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Firebase Admin (verifies phone OTP tokens from app) ──────
# Local dev: drop firebase-service-account.json in backend/ root
# Render/production: paste the ENTIRE JSON content into FIREBASE_SERVICE_ACCOUNT_JSON
# Get JSON from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=nimantran-64098
FIREBASE_SERVICE_ACCOUNT_JSON=
